#!/bin/sh

set -eu

alias=/dev/onekvm-vdec
for sys_node in /sys/class/video4linux/video*; do
	[ -r "$sys_node/name" ] || continue
	case "$(cat "$sys_node/name")" in
		*" decoder")
			video_node=/dev/$(basename "$sys_node")
			[ -e "$video_node" ] || continue
			ln -sfn "$video_node" "$alias"
			# Same access as 99-onekvm-vdec.rules when udevd is not running:
			# extensions granted device-video decode through group video.
			chgrp video "$video_node" 2>/dev/null && chmod 0660 "$video_node" || true
			exit 0
			;;
	esac
done

exit 1
